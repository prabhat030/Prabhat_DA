# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_PATH=database/anomaly_agent.db

# SMTP Email Alert Credentials
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_SENDER_EMAIL=your_email@gmail.com
ALERT_DEFAULT_RECIPIENT=analytics-alerts@company.com

# AI Layer API Configuration (Optional - for Gemini or OpenAI LLM Summaries)
# If left blank, system falls back to rule-based natural language generation
GEMINI_API_KEY=
OPENAI_API_KEY=
